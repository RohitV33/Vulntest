{
  "name": "vulnerability-scanner",
  "version": "1.0.0",
  "private": true,
  "description": "Authorized web vulnerability scanner: Node/Express crawler and safe detection modules with a React dashboard.",
  "type": "module",
  "scripts": {
    "start": "node server/src/server.js",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "postinstall": "npm --prefix server install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "start:server": "npm --prefix server start",
    "build:client": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "testbed": "node testbed/vulnerable-app.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0"
  }
}
